# AEGLOS Analytics Pro — Environment Configuration
# Copy to .env and fill in values before running
# Never commit .env to version control

# ── Authentication ────────────────────────────────────────────────────────────
# Bearer token for API auth. Leave empty to disable auth (local/desktop use).
# Generate: openssl rand -hex 32
AEGLOS_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Defaults to * if empty (dev only).
# Example: https://aeglos.yourdomain.com,http://localhost:5001
CORS_ORIGINS=

# ── Persistence ───────────────────────────────────────────────────────────────
# Directory for events.json and social_config.json
# Defaults to ~/Library/Application Support/AEGLOS/state on macOS
AEGLOS_PERSIST_DIR=

# ── Server ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=5001
WORKERS=4
DEBUG=false

# ── Docker ────────────────────────────────────────────────────────────────────
# Used by aeglos-web to reach aeglos-api inside Docker network
API_BASE_URL=http://localhost:8000

# ── Database (optional) ───────────────────────────────────────────────────────
DATABASE_URL=
REDIS_URL=redis://localhost:6379
